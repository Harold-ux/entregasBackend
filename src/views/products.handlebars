<div class="real-time"><a href="/">Go back-end</a></div>
<div>
  <label for="category">Filter by Category:</label>
  <form action="/products" method="GET">
    <select name="query">
      <option value="shoes">Shoes</option>
      <option value="cellphones">Cellphones</option>
      <option value="computers">Computers</option>
      <option value="accessories">Accessories</option>
      <option value="none">None</option>
    </select>
    <button class="btn-filter" type="submit">Filter</button>
  </form></div>
<section class="products-real">
  {{#each products}}
    <div class="card" style="width: 18rem;" data-id="{{this._id}}">
      {{#if this.photo}}
        <img src="{{this.photo}}" class="card-img-top" alt="Product Image" />
      {{else}}
        <img
          src="https://static.thenounproject.com/png/1247947-200.png"
          class="card-img-top"
          alt="Default Image"
        />
      {{/if}}
      <div class="card-body">
        <h5 class="card-title">{{this.title}}</h5>
        <div class="d-flex justify-content-between align-items-center">
          <span class="attribute">💲 {{this.price}}</span>
          <span class="attribute">📦 Stock: {{this.stock}}</span>
        </div>
        <div class="button-container">
          <a href="/product/{{this._id}}" class="button">View more</a>
          <button class="button" data-id="{{this._id}}">Delete</button>
        </div>
      </div>
    </div>
  {{/each}}
</section>
<!-- Pagination -->
<div class="pagination-container">
  {{#if hasPrevPage}}
    <a
      href="/products?page={{prevPage}}&query={{lookup query}}"
      class="pagination-button"
    >Previous</a>
  {{/if}}

  {{#if hasNextPage}}
    <a
      href="/products?page={{nextPage}}&query={{lookup query}}"
      class="pagination-button"
    >Next</a>
  {{/if}}
</div>